// TokTickIT data model.
// Lab 2 schema per docs/lab-02/specification.md section 7, extended for Lab 3
// per docs/lab-03/specification.md section 7 and for Lab 4 per
// docs/lab-04/specification.md section 7.
// DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums

/// D-03. Serves both Requested Priority and IT Priority (BR-33), so the Prisma
/// name is neutral. Mapped to the existing database type, so no SQL changes
/// (DEC-16).
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("RequestedPriority")
}

/// The labsheet's eight statuses (BR-34). CLAIMED and PENDING_CONFIRMATION
/// were renamed in place to OPEN and WAITING_FOR_REQUESTER (DEC-15); the
/// permitted transitions are enforced in the service layer, not by the type.
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

/// Exactly one role per user (BR-60).
enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

/// The changes Lab 3 records (BR-55, DEV-12), plus the two Lab 4 action events
/// (L4 BR-34). Extended with ADD VALUE only; PostgreSQL cannot drop enum values,
/// so these two survive a rollback (L4 section 7.4).
enum TicketEventType {
  OWNER_CHANGED
  STATUS_CHANGED
  IT_PRIORITY_CHANGED
  RESOLUTION_INDICATED
  ACTION_CREATED
  ACTION_UPDATED
}

/// Action Taken statuses (L4 BR-13). The permitted transitions are enforced in
/// src/lab-04/action-rules.ts, not by the type.
enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Reference data
//
// Integer primary keys (DEC-04). Reference data is public and carries no
// ownership, so an unguessable key buys nothing; keeping Category on its
// existing key also avoids a destructive migration of Lab 1 data (A-04).

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
}

// ---------------------------------------------------------------------------
// Ownership-bearing entities
//
// UUID primary keys (DEC-04). A sequential Ticket id would let one Requester
// reach another's ticket by editing a number in the URL, which BR-18 exists to
// prevent.

/// Every account: Requester, IT Staff, or Administrator. The Lab 2 model
/// RequesterUser renamed, and mapped onto its existing table so no data moves
/// (DEC-02). Emails are stored normalised (BR-06). A null passwordHash cannot
/// authenticate (BR-14), which is how migrated Lab 2 Requesters arrive.
model User {
  id                 String    @id @default(uuid())
  fullName           String
  email              String    @unique
  isActive           Boolean   @default(true)
  role               Role      @default(REQUESTER)
  passwordHash       String?
  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tickets             Ticket[]        @relation("TicketRequester")
  ownedTickets        Ticket[]        @relation("TicketOwner")
  uploadedAttachments Attachment[]    @relation("AttachmentUploadedBy")
  removedAttachments  Attachment[]    @relation("AttachmentRemovedBy")
  publicComments      PublicComment[]
  internalNotes       InternalNote[]
  ticketEvents        TicketEvent[]
  sessions            Session[]
  createdActions      ActionTaken[]   @relation("ActionCreatedBy")
  performedActions    ActionTaken[]   @relation("ActionPerformedBy")

  @@map("RequesterUser")
}

model Ticket {
  id                           String       @id @default(uuid())
  ticketNumber                 String       @unique
  requesterId                  String
  /// The Ticket Owner: the assigned IT Staff or Administrator (DEC-20).
  ownerId                      String?
  categoryId                   Int
  relatedSystemId              Int
  summary                      String
  description                  String
  requestedPriority            Priority
  /// Equal to requestedPriority at creation; only IT Staff change it (BR-33).
  itPriority                   Priority
  currentStatus                TicketStatus @default(NEW)
  requesterIndicatedResolvedAt DateTime?
  /// Incremented by every staff change, checked by conditional update
  /// (L4 DEC-06).
  version                      Int          @default(0)
  /// Set on entering RESOLVED, kept on CLOSED, cleared on REOPENED (L4 BR-25).
  resolvedAt                   DateTime?
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  requester     User            @relation("TicketRequester", fields: [requesterId], references: [id])
  owner         User?           @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category      Category        @relation(fields: [categoryId], references: [id])
  relatedSystem RelatedSystem   @relation(fields: [relatedSystemId], references: [id])
  attachments   Attachment[]
  comments      PublicComment[]
  notes         InternalNote[]
  events        TicketEvent[]
  actions       ActionTaken[]

  /// Every My Tickets query filters on requesterId and sorts by createdAt
  /// descending by default, so this composite index serves the dominant
  /// access path directly.
  @@index([requesterId, createdAt(sort: Desc)])
  /// The owner=me and owner=unassigned queue filters, and the open-ticket
  /// count in BR-63.
  @@index([ownerId])
  /// The queue's status filter plus its default age order.
  @@index([currentStatus, createdAt])
  /// Requester Dashboard counts (L4 section 7.3).
  @@index([requesterId, currentStatus])
  /// "Resolved recently" (L4 section 7.3, DEC-09).
  @@index([resolvedAt])
}

/// Removal is soft (BR-35). Active is represented by removedAt IS NULL rather
/// than a boolean flag: a nullable timestamp records both the fact and the time
/// of removal without a second field that could disagree with it.
model Attachment {
  id               String    @id @default(uuid())
  ticketId         String
  originalFilename String
  storedFilename   String
  mimeType         String
  sizeBytes        Int
  uploadedById     String
  uploadedAt       DateTime  @default(now())
  removedAt        DateTime?
  removedById      String?
  removedReason    String?

  ticket     Ticket @relation(fields: [ticketId], references: [id])
  uploadedBy User   @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])
  removedBy  User?  @relation("AttachmentRemovedBy", fields: [removedById], references: [id])

  /// The attachment list is always fetched per ticket.
  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Ticket history
//
// Append-only (BR-46, BR-54). Every foreign key is ON DELETE RESTRICT, so a
// ticket and its history are never cascade-deleted.

/// Visible to the ticket's Requester, IT Staff, and Administrators (BR-04).
model PublicComment {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

/// IT Staff and Administrators only. A separate table, so no flag can make a
/// note public (BR-50).
model InternalNote {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

/// actorId is null only for the owner clearance on reopen (BR-40, BR-55).
model TicketEvent {
  id        String          @id @default(uuid())
  ticketId  String
  actorId   String?
  eventType TicketEventType
  payload   Json
  createdAt DateTime        @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

/// An Action Taken (L4 section 7.1). Never deleted. createdBy is the caller,
/// from the session; performedBy defaults to the caller (L4 DEC-01). The check
/// constraint "followUpRequired = false OR followUpNote IS NOT NULL" backs
/// BR-09; Prisma cannot declare it, so it lives in the migration SQL only.
model ActionTaken {
  id               String       @id @default(uuid())
  ticketId         String
  createdById      String
  performedById    String
  actionAt         DateTime
  description      String
  result           String?
  status           ActionStatus
  followUpRequired Boolean      @default(false)
  followUpNote     String?
  attachmentNotes  String?
  /// Idempotent create (L4 BR-31).
  clientRequestId  String       @unique
  version          Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  createdBy   User   @relation("ActionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  performedBy User   @relation("ActionPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)

  /// The per-ticket list in BR-19 order.
  @@index([ticketId, actionAt, createdAt])
  /// "My open actions" on the IT Staff Dashboard.
  @@index([performedById, status])
}

// ---------------------------------------------------------------------------

/// A server-side session (D-04). id is the SHA-256 hex of the token; the token
/// itself is never stored (BR-15). expiresAt is the absolute limit; the idle
/// limit is measured from lastSeenAt (BR-16).
model Session {
  id         String    @id
  userId     String
  csrfToken  String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Revoking every session of a user (BR-12, BR-13, BR-64).
  @@index([userId])
}

// ---------------------------------------------------------------------------

/// One row per year. Read, incremented, and written inside the same
/// transaction that inserts the Ticket, so no gap or duplicate can result from
/// concurrent creation (BR-05). The sequence resets annually (BR-04).
model TicketNumberSequence {
  year      Int      @id
  lastValue Int
  updatedAt DateTime @updatedAt
}
