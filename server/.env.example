# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"
PORT=3000

# The test suites run against this database, never DATABASE_URL: they reseed it
# and alter seeded accounts. A separate schema in the same database is enough.
TEST_DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=toktickit_test"

# The password the seed gives every seeded account. LOCAL DEVELOPMENT ONLY:
# it is published here, so it must never be used on a real deployment.
SEED_PASSWORD="toktickit-local-dev-only"
